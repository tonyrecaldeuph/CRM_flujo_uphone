# ──────────────────────────────────────────────────────────────
# Terminal de Cobranza — plantilla de variables de entorno
# Copiar a `.env` y completar. NUNCA commitear el `.env` con valores reales.
# ──────────────────────────────────────────────────────────────

# JWT — firma de tokens de sesión. OBLIGATORIO en producción.
# Generar un valor fuerte y único (ej.: 64 bytes hex).
JWT_SECRET=
# Vigencia del token (ej.: 12h, 8h). Default en código: 12h.
JWT_EXPIRES_IN=12h

# Servidor API/WebSocket
PORT=3001
# Origen permitido por CORS. En LAN/local se autodetecta localhost/192.168/10.x.
CORS_ORIGIN=

# Entorno: 'production' exige JWT_SECRET definido (si falta, el server no arranca).
NODE_ENV=production

# Base de datos SQLite — ruta absoluta del archivo .db en el host (VM).
# Si no se define, se usa la ruta por defecto (userData de Electron / fallback).
DB_PATH=

# Carpeta de salida de reportes generados (xlsx).
REPORTS_DIR=

# ── Referencia Fase 2 (PostgreSQL/Prisma) — NO usado en la arquitectura actual ──
# DATABASE_URL=postgresql://usuario:password@host:5432/cobranza_db
